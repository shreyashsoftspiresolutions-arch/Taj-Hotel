# ==============================================================================
# Git Ignore Configuration for Luxury Hotel Management System
# ==============================================================================
# Node Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
# Uploads & Media (ignore uploaded images but keep directory)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
# Build Outputs
dist/
dist-ssr/
build/
frontend/dist/
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.sw?